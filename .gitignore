# ──────────────────────────────────────────────
# SINKA — .gitignore raíz del monorepo
# ──────────────────────────────────────────────

# Secretos y variables de entorno (NUNCA al repositorio)
.env
.env.local
.env.production
.env.development
*.env

# Archivo con las variables listas para pegar en Render: lleva claves reales
PEGAR_EN_RENDER.txt

# Salidas de los scripts de diagnostico y mantenimiento
*_resultado.txt
disk_analysis.csv

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.coveragerc
.mypy_cache/

# Alembic
backend/alembic/versions/*.pyc

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
