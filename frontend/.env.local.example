# URL del backend FastAPI
# En desarrollo local: http://localhost:8000/api
# En producción: https://tu-servicio.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Servidor TURN para la videollamada. Sin esto el video solo funciona entre
# personas cuya red permita la conexion directa. Se pueden poner varias
# direcciones separadas por coma.
# NEXT_PUBLIC_TURN_URL=turn:ejemplo.relay.metered.ca:80,turn:ejemplo.relay.metered.ca:443,turns:ejemplo.relay.metered.ca:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
